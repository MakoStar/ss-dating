---
import AssetImage from './AssetImage.astro';
import type { Row } from '../lib/types';
import { getCgByRow, getHeadByRow } from '../lib/assets';
import { starText } from '../lib/helpers';

interface Props {
  row: Row;
  index: number;
  changeAdded: string;
  changeModified: string;
}

const { row: r, index, changeAdded, changeModified } = Astro.props;

const cardVars = [
  `--i:${Math.min(index, 24)}`,
  r.charColor ? `--char-color:${r.charColor}` : null,
  r.charTagColor ? `--tag-color:${r.charTagColor}` : null,
]
  .filter(Boolean)
  .join(';');

const stars = starText(r.charGrade);
const cgImg = getCgByRow(r);
const headImg = getHeadByRow(r);
const isAboveFold = index <= 10;
const title = r.eventName?.trim() || '(unknown)';
---

<article
  class="card"
  style={cardVars}
  data-area={r.area}
  data-char-id={String(r.charId)}
  data-event-id={String(r.eventId)}
  data-char-name={r.charName ?? ''}
  data-char-grade={r.charGrade != null ? String(r.charGrade) : ''}
  data-char-job={r.charJob ?? ''}
  data-char-jobnum={r.charJobNum ?? ''}
  data-char-eet={r.charEET ?? ''}
  data-char-eetnum={r.charEETNum ?? ''}
  data-landmark-id={String(r.landmarkId)}
  data-landmark-name={r.landmarkName ?? ''}
  data-change={r.changeType}
  data-search={r.searchIndex}
>
  {
    r.eventCg && (
      <div class="card-media">
        <AssetImage
          class="card-cg"
          src={cgImg}
          alt={r.eventName ?? 'Event CG'}
          width={400}
          height={225}
          priority={isAboveFold}
        />
        {r.changeType === 'added' && (
          <span class="chip chip-new" data-i18n="changeAdded">
            {changeAdded}
          </span>
        )}
        {r.changeType === 'modified' && (
          <span class="chip chip-mod" data-i18n="changeModified">
            {changeModified}
          </span>
        )}
      </div>
    )
  }

  <div class="card-body">
    <h3 aria-label={title}>{title}</h3>

    <div class="meta">
      <AssetImage
        class="char-avatar"
        src={headImg}
        alt={r.charName ?? ''}
        width={24}
        height={24}
        priority={isAboveFold}
        fallbackAlt=""
      />

      {
        r.charName && (
          <span
            class="badge badge-char"
            style={r.charColor ? `--char-color:${r.charColor}` : undefined}
          >
            {r.charName}
          </span>
        )
      }

      {
        r.charEET && (
          <span
            class="badge badge-eet"
            style={r.charEETColor ? `--eet-color:${r.charEETColor}` : undefined}
          >
            {r.charEET}
          </span>
        )
      }

      {
        stars && (
          <span class="badge badge-stars" aria-label={`${r.charGrade} star`}>
            {stars}
          </span>
        )
      }

      {
        r.charJob && (
          <span
            class="badge badge-job"
            style={r.charTagColor ? `--tag-color:${r.charTagColor}` : undefined}
          >
            {r.charJob}
          </span>
        )
      }

      {r.landmarkName && <span class="badge badge-alt">{r.landmarkName}</span>}
    </div>

    {r.eventClue && <p class="clue">{r.eventClue}</p>}
    {r.eventOption && <p class="option">{r.eventOption}</p>}

    <footer>
      <code>char {r.charId}</code>
      <code>#{r.eventId}</code>
      {r.eventCg && <code>{r.eventCg}</code>}
    </footer>
  </div>
</article>
