---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { NO_IMAGE_SVG } from '../lib/helpers';

interface Props {
  src: ImageMetadata | undefined;
  alt: string;
  width?: number | undefined;
  height?: number | undefined;
  class?: string | undefined;
  loading?: 'lazy' | 'eager' | undefined;
  priority?: boolean | undefined;
  format?: 'webp' | 'avif' | 'png' | 'jpeg' | undefined;
  quality?: number | undefined;
  fallbackAlt?: string | undefined;
}

const {
  src,
  alt,
  width,
  height,
  class: klass,
  loading = 'lazy',
  priority,
  format = 'webp',
  quality = 80,
  fallbackAlt = 'No Image',
} = Astro.props;
---

{
  src ? (
    <Image
      src={src}
      alt={alt}
      {...priority !== undefined && { priority }}
      {...!priority && { loading }}
      decoding="async"
      format={format}
      quality={quality}
      {...width !== undefined && { width }}
      {...height !== undefined && { height }}
      {...klass !== undefined && { class: klass }}
    />
  ) : (
    <img
      src={NO_IMAGE_SVG}
      alt={fallbackAlt}
      {...!priority && { loading }}
      {...width !== undefined && { width }}
      {...height !== undefined && { height }}
      {...klass !== undefined && { class: klass }}
    />
  )
}
