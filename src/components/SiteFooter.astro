---
interface Props {
  thanks: string;
  about: string;
  repo: string;
  copy: string;
}

const { thanks, about, repo, copy } = Astro.props;
const buildTimeIso = __BUILD_DATE__;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="nav-dot" aria-hidden="true"></span>
      <span>Stella Dating Events</span>
    </div>

    <p class="footer-text" data-i18n="footerThanks">{thanks}</p>
    <p class="footer-text" data-i18n="footerAbout">{about}</p>
    <p class="footer-text">
      <span data-i18n="builtAt"></span>
      <time datetime={buildTimeIso} data-build-time>{buildTimeIso}</time>
    </p>

    <div class="footer-links">
      <a
        href="https://github.com/MakoStar/ss-dating"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
      >
        <span aria-hidden="true">📦</span>
        <span data-i18n="footerRepo">{repo}</span>
      </a>
      <a
        href="https://stelladb.pages.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link"
      >
        <span aria-hidden="true">⚡</span>
        <span>stelladb</span>
      </a>
    </div>

    <p class="footer-copy" data-i18n="footerCopy">{copy}</p>
  </div>
</footer>
